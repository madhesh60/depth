{
  // DEPTH in GitHub Codespaces: the real studio, CPU-only, nothing to install on your machine.
  // Create the codespace, wait ~3 min for the setup below, and the studio opens on the forwarded port 8000.
  "name": "DEPTH studio",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  // the torch-free runtime, the detector (38 MB, SHA-256 checked) and a raw sonar recording with real GPS (11 MB)
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && python -m src.detection.fetch_model && (python -m src.cv_pipeline.humminbird fetch || echo 'the recording download failed - the studio runs without it')",
  "postAttachCommand": "python -m uvicorn src.dashboard.app:app --host 0.0.0.0 --port 8000",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "DEPTH studio", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["JUDGES.md"] }
  }
}
