# depth.service — the live DEPTH server on the COOL AMI (rendered by infra/setup_cool_instance.sh).
# Runs with the COOL interpreter so every OpenCV call (Stage 1, cv2.dnn, rendering) uses COOL's
# OpenCV 5 build; the web deps come from /opt/depth/pydeps (the COOL venv is never modified).
[Unit]
Description=DEPTH marine-debris agent (FastAPI + OpenCV 5 COOL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=depth
Group=depth
WorkingDirectory=@APP@
Environment=PYTHONPATH=@APP@:@APP@/pydeps
Environment=PYTHONUNBUFFERED=1
Environment=DEPTH_THREADS=@THREADS@
Environment=DEPTH_MODEL=@MODEL@
Environment=DEPTH_JOBS_DIR=@APP@/runs/jobs
Environment=DEPTH_S3_BUCKET=@S3_BUCKET@
Environment=DEPTH_CORS_ORIGINS=@CORS@
Environment=DEPTH_LOG_JSON=1
ExecStart=@COOL_PY@ -m uvicorn src.dashboard.app:app --host 0.0.0.0 --port @PORT@ --workers 1 --timeout-keep-alive 30
Restart=always
RestartSec=3
# light hardening
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=@APP@/runs /var/log/depth
PrivateTmp=true

[Install]
WantedBy=multi-user.target
