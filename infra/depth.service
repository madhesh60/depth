# depth.service — the live DEPTH server on the COOL AMI (rendered by infra/setup_cool_instance.sh).
# Runs with the COOL interpreter so every OpenCV call (Stage 1, cv2.dnn, rendering) uses COOL's
# OpenCV 5 build; the web deps come from /opt/depth/pydeps (the COOL venv is never modified).
[Unit]
Description=DEPTH marine-debris agent (FastAPI + OpenCV 5 COOL)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=depth
Group=depth
WorkingDirectory=@APP@
Environment=PYTHONPATH=@APP@:@APP@/pydeps
Environment=PYTHONUNBUFFERED=1
Environment=DEPTH_THREADS=@THREADS@
Environment=DEPTH_MODEL=@MODEL@
Environment=DEPTH_JOBS_DIR=@APP@/runs/jobs
Environment=DEPTH_S3_BUCKET=@S3_BUCKET@
Environment=DEPTH_CORS_ORIGINS=@CORS@
Environment=DEPTH_LOG_JSON=1
# MCP at /mcp: CloudFront does not forward Host, so the allow-list is opened and the bearer token
# (root-only /etc/depth/mcp.env, generated by setup_cool_instance.sh) is what guards it.
Environment=DEPTH_MCP_ALLOWED_HOSTS=*
EnvironmentFile=-/etc/depth/mcp.env
EnvironmentFile=-/etc/depth/admin.env
EnvironmentFile=-/etc/depth/approver.env
# CloudFront's X-Origin-Verify secret (only our distribution gets in) and the public https address
EnvironmentFile=-/etc/depth/origin.env
EnvironmentFile=-/etc/depth/public.env
# present only on a stock-Ubuntu dress rehearsal (Rehearsal=true): every COOL claim says "rehearsal"
EnvironmentFile=-/etc/depth/rehearsal.env
# behind CloudFront: the viewer's address is the LAST X-Forwarded-For hop, the one CloudFront appends
# (per-client rate limits; the first hop is whatever the visitor sent)
Environment=DEPTH_TRUST_PROXY=1
ExecStart=@COOL_PY@ -m uvicorn src.dashboard.app:app --host 0.0.0.0 --port @PORT@ --workers 1 --timeout-keep-alive 30
Restart=always
RestartSec=3
# the journal also goes to a file the CloudWatch agent ships (logrotate: /etc/logrotate.d/depth)
StandardOutput=append:/var/log/depth/depth.log
StandardError=inherit
# light hardening
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=@APP@/runs /var/log/depth
PrivateTmp=true

[Install]
WantedBy=multi-user.target
